# =============================================================
# 复制为 .env 并修改：cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到 GitHub
# =============================================================

# NapCat 容器内运行用户（服务器上执行 id -u / id -g 查看，root 为 0）
NAPCAT_UID=1000
NAPCAT_GID=1000

# NapCat WebUI 访问 token（自己设一个复杂的，登录 WebUI 时要用）
NAPCAT_WEBUI_TOKEN=change-me-to-a-random-string

# 若在 NapCat WebUI 里给 OneBot WS 服务配置了 token，这里填同一个；
# 不配 token 就留空
NAPCAT_WS_TOKEN=

# 机器人超管 QQ 号（可选，多个用英文逗号分隔）
SUPERUSERS=

# ===== AI 对话（DeepSeek）=====
# 申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 初始超级管理员 QQ 号（逗号分隔，仅首次生效，之后可在管理面板里增删）
SUPERADMINS=
